; This gromacs .mdp file was generated
; as /wynton/home/grabe/jborowsky/aac1/auto-gmx-equil-2/run20/seg_01_minimization_01.mdp
; by /wynton/home/grabe/jborowsky/aac1/auto-gmx-equil-2/scripts/make-topology-restraint-mdp.py
; on 2025-01-22 15:29:28.834281

; integration
integrator               = steep
emstep                   = 0.001
nsteps                   = 500000
emtol                    = 1000

; neighbor searching
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz

; electrostatics
coulombtype              = PME
pme-order                = 4
fourierspacing           = 0.12
rcoulomb                 = 1.2

; Van der Waals
vdwtype                  = cut-off
vdw-modifier             = force-switch
rvdw-switch              = 1
rvdw                     = 1.2

; restraints
define                   = -DPOSRES -DPOSRES_FC_BB=4000 -DPOSRES_FC_SC=4000 -DPOSRES_FC_TLCL2=400 -DPOSRES_FC_POPC=400 -DPOSRES_FC_TIP3=400 -DPOSRES_FC_CLA=400 -DPOSRES_FC_POT=400 -DPOSRES_FC_ARAN=400

; output control; frequencies in steps
nstxout                  = 50
nstenergy                = 10
