; This gromacs .mdp file was generated
; as /wynton/home/grabe/jborowsky/aac1/auto-gmx-equil-2/run21/seg_18_NPT_09.mdp
; by /wynton/home/grabe/jborowsky/aac1/auto-gmx-equil-2/scripts/make-topology-restraint-mdp.py
; on 2025-01-22 15:33:49.911264

; input handling
gen-vel                  = no
continuation             = yes

; integration
integrator               = md
dt                       = 0.002
nsteps                   = 1000000
tinit                    = 24400.0

; bonded interactions
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

; neighbor searching
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz

; electrostatics
coulombtype              = PME
pme-order                = 4
fourierspacing           = 0.12
rcoulomb                 = 1.2

; Van der Waals
vdwtype                  = cut-off
vdw-modifier             = force-switch
rvdw-switch              = 1
rvdw                     = 1.2

; restraints
define                   = -DPOSRES -DPOSRES_FC_BB=1000 -DPOSRES_FC_SC=400 -DPOSRES_FC_TLCL2=0 -DPOSRES_FC_POPC=0 -DPOSRES_FC_TIP3=0 -DPOSRES_FC_CLA=0 -DPOSRES_FC_POT=0 -DPOSRES_FC_ARAN=0

; thermostat
tcoupl                   = berendsen
tc_grps                  = System
tau-t                    = 1
ref-t                    = 310.15

; barostat
pcoupl                   = berendsen
pcoupltype               = semiisotropic
tau-p                    = 5
ref-p                    = 1.01325 1.01325
compressibility          = 4.5e-05 4.5e-05
refcoord-scaling         = com

; output control; frequencies in steps
nstxout                  = 5000
nstvout                  = 5000
nstlog                   = 5000
nstenergy                = 5000
nstxout-compressed       = 5000
