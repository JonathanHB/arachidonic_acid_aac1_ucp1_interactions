; This gromacs .mdp file was generated
; as /wynton/home/grabe/jborowsky/aac1/auto-gmx-equil-2/run21/seg_02_NVT_02.mdp
; by /wynton/home/grabe/jborowsky/aac1/auto-gmx-equil-2/scripts/make-topology-restraint-mdp.py
; on 2025-01-22 15:33:49.854124

; input handling
gen-vel                  = yes
gen-temp                 = 310.15
gen-seed                 = -1
continuation             = no

; integration
integrator               = md
dt                       = 0.002
nsteps                   = 50000
tinit                    = 0

; bonded interactions
constraints              = h-bonds
constraint-algorithm     = lincs
lincs-order              = 4
lincs-iter               = 1

; neighbor searching
cutoff-scheme            = Verlet
nstlist                  = 20
pbc                      = xyz

; electrostatics
coulombtype              = PME
pme-order                = 4
fourierspacing           = 0.12
rcoulomb                 = 1.2

; Van der Waals
vdwtype                  = cut-off
vdw-modifier             = force-switch
rvdw-switch              = 1
rvdw                     = 1.2

; restraints
define                   = -DPOSRES -DPOSRES_FC_BB=4000 -DPOSRES_FC_SC=4000 -DPOSRES_FC_TLCL2=400 -DPOSRES_FC_POPC=400 -DPOSRES_FC_TIP3=400 -DPOSRES_FC_CLA=400 -DPOSRES_FC_POT=400 -DPOSRES_FC_ARAN=400

; thermostat
tcoupl                   = berendsen
tc_grps                  = System
tau-t                    = 1
ref-t                    = 310.15

; output control; frequencies in steps
nstxout                  = 5000
nstvout                  = 5000
nstlog                   = 5000
nstenergy                = 5000
nstxout-compressed       = 5000
